// Cloudflare Workers: serves the static build in dist/ from the edge.
// Redirects come from astro.config.mjs (written to dist/_redirects at build),
// cache headers from public/_headers. Only /api/* runs code (worker/index.ts).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agentdrops-website",
  "compatibility_date": "2026-10-01",
  "main": "./worker/index.ts",
  "assets": {
    "directory": "./dist",
    // Unknown addresses get the custom 404 page with a 404 status.
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"],
  },
  // Plain config goes in "vars"; secrets go through `npx wrangler secret put NAME`.
  "vars": {},
  // Required by `wrangler preview`, which Workers Builds runs for PR branches.
  // Empty is fine: assets and compatibility settings are inherited from above.
  "previews": {},
}
