---
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<p
  class:list={[
    'inline-flex items-center gap-2 font-mono text-xs tracking-[0.14em] text-muted uppercase',
    className,
  ]}
>
  <span class="size-1.5 rounded-full bg-accent" aria-hidden="true"></span>
  <slot />
</p>
