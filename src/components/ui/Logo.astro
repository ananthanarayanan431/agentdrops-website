---
/**
 * The AgentDrops lockup: the mark plus the wordmark. The mark is the Icons8
 * "water" icon (iOS Filled, id 9021; see icons8.json), shipped as PNG in two
 * colours so it follows the light and dark themes.
 */
interface Props {
  class?: string;
  /** Show only the mark, for tight spaces. */
  markOnly?: boolean;
}
const { class: className = '', markOnly = false } = Astro.props;
---

<span class:list={['inline-flex items-center gap-2', className]}>
  <picture class="shrink-0">
    <source srcset="/brand/mark-dark.png" media="(prefers-color-scheme: dark)" />
    <img src="/brand/mark-light.png" alt="" width="28" height="28" class="size-7" />
  </picture>
  {!markOnly && (
    <span class="text-[1.05rem] font-semibold tracking-tight text-ink">
      Agent<span class="text-accent">Drops</span>
    </span>
  )}
</span>
