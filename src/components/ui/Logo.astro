---
/**
 * The AgentDrops lockup: the mark plus the wordmark. The mark lives in one
 * place (here) so swapping the artwork updates the header, footer and favicon
 * source together.
 */
interface Props {
  class?: string;
  /** Show only the mark, for tight spaces. */
  markOnly?: boolean;
}
const { class: className = '', markOnly = false } = Astro.props;
---

<span class:list={['inline-flex items-center gap-2.5', className]}>
  <svg
    class="size-7 shrink-0"
    viewBox="0 0 32 32"
    aria-hidden="true"
    focusable="false"
    data-logo-mark
  >
    <path
      d="M16 3c4.6 5.4 9 10.6 9 16a9 9 0 0 1-18 0c0-5.4 4.4-10.6 9-16Z"
      fill="var(--accent)"
    ></path>
    <circle cx="16" cy="19.5" r="3.2" fill="var(--accent-ink)"></circle>
  </svg>
  {!markOnly && (
    <span class="text-[1.05rem] font-semibold tracking-tight text-ink">
      Agent<span class="text-accent">Drops</span>
    </span>
  )}
</span>
