---
import { ArrowRight } from '@lucide/astro';

interface Props {
  href: string;
  variant?: 'primary' | 'ghost';
  class?: string;
}
const { href, variant = 'primary', class: className = '' } = Astro.props;
---

<a
  href={href}
  class:list={[
    'group inline-flex items-center gap-2 rounded-full px-5 py-3 text-sm font-medium transition-colors',
    variant === 'primary'
      ? 'bg-ink text-bg hover:bg-brand hover:text-brand-ink'
      : 'border border-line text-ink hover:border-ink',
    className,
  ]}
>
  <slot />
  <ArrowRight class="size-4 transition-transform group-hover:translate-x-0.5" aria-hidden="true" />
</a>
