---
import SectionHeader from '@/components/ui/SectionHeader.astro';
import { problem } from '@/data/company';
---

<section class="border-y border-line bg-bg-2/60 py-20 sm:py-28" aria-labelledby="problem-title">
  <div class="wrap">
    <SectionHeader
      id="problem-title"
      eyebrow={problem.eyebrow}
      title={problem.title}
      lede={problem.lede}
    />
    <dl class="mt-14 grid gap-px overflow-hidden rounded-3xl border border-line bg-line md:grid-cols-3">
      {problem.stats.map((s) => (
        <div class="flex flex-col bg-surface p-8">
          <dt class="order-2 mt-3 text-ink-2">{s.label}</dt>
          <dd class="order-1 text-6xl font-semibold tracking-tight">{s.value}</dd>
          <dd class="order-3 mt-6 font-mono text-xs text-muted">Source: {s.source}</dd>
        </div>
      ))}
    </dl>
    <p class="mt-10 max-w-3xl text-lg text-pretty text-ink-2">{problem.close}</p>
  </div>
</section>
