---
import Eyebrow from '@/components/ui/Eyebrow.astro';

interface Props {
  eyebrow: string;
  title: string;
  lede?: string;
}
const { eyebrow, title, lede } = Astro.props;
---

<section class="relative overflow-hidden border-b border-line">
  <div class="lab-grid pointer-events-none absolute inset-0" aria-hidden="true"></div>
  <div class="wrap relative pt-16 pb-16 sm:pt-24 sm:pb-20">
    <Eyebrow>{eyebrow}</Eyebrow>
    <h1 class="mt-6 max-w-4xl text-[2.4rem] leading-[1.04] font-semibold tracking-[-0.03em] text-balance sm:text-6xl">
      {title}
    </h1>
    {lede && <p class="mt-6 max-w-2xl text-lg text-pretty text-ink-2 sm:text-xl">{lede}</p>}
  </div>
</section>
