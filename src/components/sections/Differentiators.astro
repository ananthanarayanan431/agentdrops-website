---
import { Check } from '@lucide/astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import { differentiators } from '@/data/company';
---

<section class="py-20 sm:py-28" aria-labelledby="diff-title">
  <div class="wrap">
    <SectionHeader
      id="diff-title"
      eyebrow="Why AgentDrops"
      title="What you get that a demo doesn’t give you."
    />
    <ul class="mt-14 grid gap-x-10 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
      {differentiators.map((d) => (
        <li>
          <span class="flex size-8 items-center justify-center rounded-full border border-line text-accent">
            <Check class="size-4" aria-hidden="true" />
          </span>
          <h3 class="mt-4 text-lg font-semibold tracking-tight">{d.title}</h3>
          <p class="mt-1.5 text-ink-2">{d.body}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
