---
import Button from '@/components/ui/Button.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import { hero, method } from '@/data/company';
---

<section class="relative overflow-hidden">
  <div class="lab-grid pointer-events-none absolute inset-0" aria-hidden="true"></div>
  <div class="wrap relative grid items-center gap-14 pt-16 pb-20 sm:pt-24 lg:grid-cols-[1.15fr_1fr] lg:pb-28">
    <div>
      <Eyebrow>{hero.eyebrow}</Eyebrow>
      <h1 class="mt-6 text-[2.6rem] leading-[1.02] font-semibold tracking-[-0.035em] text-balance sm:text-6xl lg:text-7xl">
        {hero.title}
        <span class="block text-accent">{hero.titleAccent}</span>
      </h1>
      <p class="mt-7 max-w-xl text-lg text-pretty text-ink-2 sm:text-xl">{hero.lede}</p>
      <div class="mt-9 flex flex-wrap gap-3">
        <Button href={hero.primary.href}>{hero.primary.label}</Button>
        <Button href={hero.secondary.href} variant="ghost">
          {hero.secondary.label}
        </Button>
      </div>
    </div>

    <!-- The drop: an idea falls into the lab, and the method ripples out from it. -->
    <figure class="relative mx-auto w-full max-w-md px-6 sm:px-0" aria-label="Lab to drop">
      <div class="relative aspect-square">
        <svg viewBox="0 0 400 400" class="absolute inset-0 size-full" aria-hidden="true">
          <defs>
            <radialGradient id="pool" cx="50%" cy="50%" r="50%">
              <stop offset="0%" stop-color="var(--accent)" stop-opacity="0.18"></stop>
              <stop offset="100%" stop-color="var(--accent)" stop-opacity="0"></stop>
            </radialGradient>
          </defs>
          <circle cx="200" cy="200" r="190" fill="url(#pool)"></circle>
          <circle
            cx="200"
            cy="200"
            r="188"
            fill="none"
            stroke="var(--line)"
            stroke-dasharray="2 6"
          ></circle>
          <circle cx="200" cy="200" r="130" fill="none" stroke="var(--line)"></circle>
          <circle cx="200" cy="200" r="70" fill="none" stroke="var(--line)"></circle>
          <g>
            <circle
              class="ripple"
              cx="200"
              cy="200"
              r="185"
              fill="none"
              stroke="var(--accent)"
            ></circle>
            <circle
              class="ripple"
              cx="200"
              cy="200"
              r="185"
              fill="none"
              stroke="var(--accent)"
            ></circle>
            <circle
              class="ripple"
              cx="200"
              cy="200"
              r="185"
              fill="none"
              stroke="var(--accent-2)"
            ></circle>
          </g>
          <path
            class="drop-fall"
            d="M200 160c9 11 18 21 18 32a18 18 0 0 1-36 0c0-11 9-21 18-32Z"
            fill="var(--accent)"
          ></path>
          <circle cx="200" cy="200" r="6" fill="var(--ink)"></circle>
        </svg>
        <ol class="absolute inset-0">
          {method.steps.map((step, i) => {
            const angle = (i / method.steps.length) * Math.PI * 2 - Math.PI / 2;
            const x = 50 + Math.cos(angle) * 47;
            const y = 50 + Math.sin(angle) * 47;
            return (
              <li
                class="absolute -translate-x-1/2 -translate-y-1/2 rounded-full border border-line bg-surface px-3 py-1.5 font-mono text-[0.7rem] whitespace-nowrap text-ink-2 shadow-sm sm:text-xs"
                style={`left:${x}%;top:${y}%`}
              >
                <span class="text-accent">{step.n}</span> {step.name}
              </li>
            );
          })}
        </ol>
      </div>
      <figcaption class="mt-4 text-center font-mono text-xs text-muted">
        Every idea passes the same six steps before it ships.
      </figcaption>
    </figure>
  </div>
</section>
