---
import Button from '@/components/ui/Button.astro';
import { cta } from '@/data/company';
---

<section class="py-12" aria-labelledby="cta-title">
  <div class="wrap">
    <div class="theme-dark relative overflow-hidden rounded-[2rem] bg-brand bg-[radial-gradient(120%_120%_at_100%_100%,var(--brand)_0%,var(--brand-2)_70%)] px-6 py-16 text-ink sm:px-14 sm:py-20">
      <svg
        viewBox="0 0 400 400"
        class="pointer-events-none absolute -right-24 -bottom-32 size-[28rem] opacity-60"
        aria-hidden="true"
      >
        <circle
          class="ripple"
          cx="200"
          cy="200"
          r="190"
          fill="none"
          stroke="var(--accent)"
        ></circle>
        <circle
          class="ripple"
          cx="200"
          cy="200"
          r="190"
          fill="none"
          stroke="var(--accent)"
        ></circle>
        <circle
          class="ripple"
          cx="200"
          cy="200"
          r="190"
          fill="none"
          stroke="var(--accent-2)"
        ></circle>
      </svg>
      <div class="relative max-w-2xl">
        <h2 id="cta-title" class="text-3xl font-semibold tracking-tight text-balance sm:text-5xl">
          {cta.title}
        </h2>
        <p class="mt-5 text-lg text-ink-2">{cta.body}</p>
        <Button href={cta.href} class="mt-9 hover:!bg-black hover:!text-white">
          {cta.label}
        </Button>
      </div>
    </div>
  </div>
</section>
