---
import { Menu, X } from '@lucide/astro';
import Logo from '@/components/ui/Logo.astro';
import { CONTACT, NAV } from '@/config/site';

const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || path.startsWith(href);
---

<header class="sticky top-0 z-40 border-b border-line/70 bg-bg/80 backdrop-blur-md supports-[backdrop-filter]:bg-bg/65">
  <a
    href="#main"
    class="sr-only rounded bg-ink px-3 py-2 text-bg focus:not-sr-only focus:absolute focus:top-3 focus:left-3"
  >
    Skip to content
  </a>
  <div class="wrap flex h-16 items-center justify-between gap-6">
    <a href="/" aria-label="AgentDrops home" class="shrink-0">
      <Logo />
    </a>

    <nav aria-label="Main" class="hidden items-center gap-1 md:flex">
      {NAV.map((item) => (
        <a
          href={item.href}
          aria-current={isCurrent(item.href) ? 'page' : undefined}
          class="rounded-full px-4 py-2 text-sm text-ink-2 transition-colors hover:text-ink aria-[current=page]:bg-bg-2 aria-[current=page]:text-ink"
        >
          {item.label}
        </a>
      ))}
    </nav>

    <a
      href={CONTACT.href}
      class="hidden rounded-full bg-ink px-4 py-2 text-sm font-medium text-bg transition-colors hover:bg-accent hover:text-accent-ink md:inline-flex"
    >
      Start a project
    </a>

    <details class="group relative md:hidden">
      <summary
        class="flex size-10 cursor-pointer list-none items-center justify-center rounded-full border border-line [&::-webkit-details-marker]:hidden"
        aria-label="Menu"
      >
        <Menu class="size-5 group-open:hidden" aria-hidden="true" />
        <X class="hidden size-5 group-open:block" aria-hidden="true" />
      </summary>
      <nav
        aria-label="Mobile"
        class="absolute top-12 right-0 w-56 rounded-2xl border border-line bg-surface p-2 shadow-xl"
      >
        {[...NAV, CONTACT].map((item) => (
          <a
            href={item.href}
            aria-current={isCurrent(item.href) ? 'page' : undefined}
            class="block rounded-xl px-4 py-3 text-sm text-ink-2 hover:bg-bg-2 hover:text-ink aria-[current=page]:text-ink"
          >
            {item.label}
          </a>
        ))}
      </nav>
    </details>
  </div>
</header>
