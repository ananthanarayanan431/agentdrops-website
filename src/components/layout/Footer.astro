---
import Logo from '@/components/ui/Logo.astro';
import { CONTACT, NAV, site } from '@/config/site';
import { services } from '@/data/company';

const year = new Date().getFullYear();
---

<footer class="theme-dark mt-24 bg-bg text-ink">
  <div class="wrap grid gap-12 py-16 md:grid-cols-[1.4fr_1fr_1fr]">
    <div class="max-w-sm">
      <Logo tone="light" />
      <p class="mt-4 text-sm text-ink-2">{site.tagline}</p>
      <a
        href={`mailto:${site.email}`}
        class="mt-6 inline-block font-mono text-sm text-ink underline decoration-line underline-offset-4 hover:decoration-accent"
      >
        {site.email}
      </a>
    </div>
    <nav aria-label="Services">
      <p class="font-mono text-xs tracking-[0.14em] text-muted uppercase">What we build</p>
      <ul class="mt-4 space-y-2.5 text-sm">
        {services.map((s) => (
          <li>
            <a href={`/services/#${s.slug}`} class="text-ink-2 hover:text-ink">
              {s.name}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <nav aria-label="Company">
      <p class="font-mono text-xs tracking-[0.14em] text-muted uppercase">Company</p>
      <ul class="mt-4 space-y-2.5 text-sm">
        {[...NAV, CONTACT].map((item) => (
          <li>
            <a href={item.href} class="text-ink-2 hover:text-ink">
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
  <div class="border-t border-line">
    <div class="wrap flex flex-col gap-2 py-6 font-mono text-xs text-muted sm:flex-row sm:justify-between">
      <p>
        © {year} {site.name}. All rights reserved.
      </p>
      <p>
        Logo icon by{' '}
        <a
          href="https://icons8.com"
          rel="noopener"
          class="underline underline-offset-4 hover:text-ink"
        >
          Icons8
        </a>
      </p>
    </div>
  </div>
</footer>
