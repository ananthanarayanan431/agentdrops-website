---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Cta from '@/components/sections/Cta.astro';
import PageHero from '@/components/sections/PageHero.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import Logo from '@/components/ui/Logo.astro';
import { principles, sources, story } from '@/data/company';
---

<BaseLayout
  title="Company"
  description="AgentDrops is a research-first AI company: researchers who ship agentic products, voice agents and custom software."
>
  <PageHero eyebrow={story.eyebrow} title={story.title} />

  <section class="py-20 sm:py-24" aria-label="Our story">
    <div class="wrap grid gap-14 lg:grid-cols-[1.4fr_1fr]">
      <div class="prose-ad max-w-2xl text-lg text-ink-2 sm:text-xl">
        {story.paragraphs.map((p) => (
          <p>{p}</p>
        ))}
      </div>
      <aside class="self-start rounded-3xl border border-line bg-surface p-8">
        <Logo />
        <h2 class="mt-6 text-xl font-semibold tracking-tight">{story.name.title}</h2>
        <p class="mt-3 text-ink-2">{story.name.body}</p>
      </aside>
    </div>
  </section>

  <section
    class="border-y border-line bg-bg-2/60 py-20 sm:py-28"
    aria-labelledby="principles-title"
  >
    <div class="wrap">
      <SectionHeader id="principles-title" eyebrow="Principles" title="Five rules we work by." />
      <ol class="mt-14 divide-y divide-line border-y border-line">
        {principles.map((p, i) => (
          <li class="grid gap-2 py-6 sm:grid-cols-[4rem_1fr_1fr] sm:items-baseline sm:gap-6">
            <span class="font-mono text-sm text-accent">0{i + 1}</span>
            <h3 class="text-2xl font-semibold tracking-tight">{p.title}</h3>
            <p class="text-ink-2">{p.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="py-20" aria-labelledby="sources-title">
    <div class="wrap max-w-3xl">
      <h2 id="sources-title" class="font-mono text-xs tracking-[0.14em] text-muted uppercase">
        Sources for figures on this site
      </h2>
      <ul class="mt-5 space-y-3 text-sm">
        {sources.map((s) => (
          <li>
            <a
              href={s.href}
              rel="noopener"
              class="text-ink-2 underline decoration-line underline-offset-4 hover:text-ink hover:decoration-accent"
            >
              {s.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <Cta />
</BaseLayout>
