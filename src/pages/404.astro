---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { site } from '@/config/site';
---

<BaseLayout title={`Page not found | ${site.name}`} noindex>
  <section class="mx-auto max-w-3xl px-4 py-24">
    <h1 class="text-4xl font-semibold tracking-tight">Page not found</h1>
    <p class="mt-4"><a class="underline" href="/">Back to the home page</a></p>
  </section>
</BaseLayout>
