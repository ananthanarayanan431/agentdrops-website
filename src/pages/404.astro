---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/ui/Button.astro';
---

<BaseLayout title="Page not found" noindex>
  <section class="wrap py-28 sm:py-36">
    <p class="font-mono text-sm text-accent">404</p>
    <h1 class="mt-4 text-4xl font-semibold tracking-tight sm:text-6xl">Page not found</h1>
    <p class="mt-4 max-w-lg text-lg text-ink-2">
      This experiment didn’t pan out. The page you were looking for isn’t here.
    </p>
    <Button href="/" class="mt-8">
      Back to the home page
    </Button>
  </section>
</BaseLayout>
