---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Cta from '@/components/sections/Cta.astro';
import ExperimentRecord from '@/components/sections/ExperimentRecord.astro';
import PageHero from '@/components/sections/PageHero.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import { labRules, method, researchAreas } from '@/data/company';
---

<BaseLayout
  title="Lab"
  description="How AgentDrops experiments before it builds: written questions, success lines, kill rules and results measured on real cases."
>
  <PageHero
    eyebrow="The lab"
    title="We find out if it works before you pay for it to be built."
    lede="Research is not a phase we bill around. It is the first thing we deliver: a written experiment, run on your real cases, with results you can read."
  />

  <section class="py-20 sm:py-28" aria-labelledby="record-title">
    <div class="wrap grid items-start gap-14 lg:grid-cols-2">
      <div>
        <SectionHeader
          id="record-title"
          eyebrow="The experiment record"
          title="Written down before it runs."
          lede="Every experiment starts as a record like this one. The question, the success line and the kill rule are fixed before we look at a single result, so the outcome can’t be argued into a win."
        />
        <ul class="mt-8 space-y-3">
          {labRules.map((rule) => (
            <li class="flex gap-3 text-ink-2">
              <span class="mt-2.5 size-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true" />
              {rule}
            </li>
          ))}
        </ul>
      </div>
      <ExperimentRecord />
    </div>
  </section>

  <section class="border-y border-line bg-bg-2/60 py-20 sm:py-28" aria-labelledby="areas-title">
    <div class="wrap">
      <SectionHeader
        id="areas-title"
        eyebrow="Research areas"
        title="Four questions under everything we build."
      />
      <ul class="mt-14 grid gap-4 md:grid-cols-2">
        {researchAreas.map((a, i) => (
          <li class="rounded-3xl border border-line bg-surface p-8">
            <p class="font-mono text-xs text-accent">Area 0{i + 1}</p>
            <h3 class="mt-4 text-2xl font-semibold tracking-tight">{a.name}</h3>
            <p class="mt-3 text-lg text-ink">{a.question}</p>
            <p class="mt-2 text-ink-2">{a.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="py-20 sm:py-28" aria-labelledby="out-title">
    <div class="wrap">
      <SectionHeader
        id="out-title"
        eyebrow="What leaves the lab"
        title="Three possible outcomes. All of them useful."
      />
      <ul class="mt-14 grid gap-4 md:grid-cols-3">
        <li class="rounded-3xl border border-line bg-surface p-8">
          <p class="flex items-center gap-2 font-mono text-xs tracking-wider text-ok uppercase">
            <span class="size-2 rounded-full bg-ok" aria-hidden="true"></span> Drop
          </p>
          <p class="mt-4 text-ink-2">
            The success line held. We build the production version on the approach that won.
          </p>
        </li>
        <li class="rounded-3xl border border-line bg-surface p-8">
          <p class="flex items-center gap-2 font-mono text-xs tracking-wider text-accent uppercase">
            <span class="size-2 rounded-full bg-accent" aria-hidden="true"></span> Iterate
          </p>
          <p class="mt-4 text-ink-2">
            Close, but not there. We change one variable, write a new record and run again.
          </p>
        </li>
        <li class="rounded-3xl border border-line bg-surface p-8">
          <p class="flex items-center gap-2 font-mono text-xs tracking-wider text-muted uppercase">
            <span class="size-2 rounded-full bg-muted" aria-hidden="true"></span> Stop
          </p>
          <p class="mt-4 text-ink-2">
            The kill rule fired. You get the data and our reasons, before any build budget is spent.
          </p>
        </li>
      </ul>
      <p class="mt-8 text-2xl font-semibold tracking-tight">{method.closer}</p>
    </div>
  </section>

  <Cta />
</BaseLayout>
