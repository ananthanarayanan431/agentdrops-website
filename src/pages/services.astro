---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Cta from '@/components/sections/Cta.astro';
import Method from '@/components/sections/Method.astro';
import PageHero from '@/components/sections/PageHero.astro';
import ServiceIcon from '@/components/ui/ServiceIcon.astro';
import { Check } from '@lucide/astro';
import { audiences, services } from '@/data/company';
---

<BaseLayout
  title="Services"
  description="Agentic products, voice agents, custom software, applied research and AI automation, each one tested in the lab before it is built."
>
  <PageHero
    eyebrow="Services"
    title="Agents, voice and software. Proven before they’re built."
    lede="Five kinds of work, one method behind all of them: experiment, measure, then build what the evidence supports."
  />

  <nav aria-label="Services on this page" class="border-b border-line">
    <ul class="wrap flex gap-2 overflow-x-auto py-4">
      {services.map((s) => (
        <li class="shrink-0">
          <a
            href={`#${s.slug}`}
            class="inline-flex items-center gap-2 rounded-full border border-line px-4 py-2 text-sm text-ink-2 hover:border-ink hover:text-ink"
          >
            <ServiceIcon name={s.icon} class="size-4" />
            {s.name}
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <div class="wrap divide-y divide-line">
    {services.map((s, i) => (
      <section
        id={s.slug}
        class="grid scroll-mt-20 gap-10 py-16 sm:py-20 lg:grid-cols-[1fr_1.3fr]"
        aria-labelledby={`${s.slug}-title`}
      >
        <div>
          <p class="font-mono text-xs text-muted">0{i + 1}</p>
          <span class="mt-4 flex size-12 items-center justify-center rounded-2xl bg-accent/10 text-accent">
            <ServiceIcon name={s.icon} class="size-6" />
          </span>
          <h2 id={`${s.slug}-title`} class="mt-6 text-3xl font-semibold tracking-tight sm:text-4xl">
            {s.name}
          </h2>
          <p class="mt-3 text-lg text-ink-2">{s.summary}</p>
        </div>
        <div>
          <ul class="space-y-4">
            {s.points.map((p) => (
              <li class="flex gap-3 border-b border-dashed border-line pb-4 text-ink-2">
                <Check class="mt-1 size-4 shrink-0 text-accent" aria-hidden="true" />
                {p}
              </li>
            ))}
          </ul>
          {s.note && (
            <p class="mt-6 rounded-2xl bg-bg-2 p-5 font-mono text-sm text-ink-2">{s.note}</p>
          )}
        </div>
      </section>
    ))}
  </div>

  <section class="border-y border-line bg-bg-2/60 py-20" aria-labelledby="who-title">
    <div class="wrap">
      <h2 id="who-title" class="text-3xl font-semibold tracking-tight sm:text-4xl">
        Who we work with
      </h2>
      <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {audiences.map((a) => (
          <li class="rounded-3xl border border-line bg-surface p-6">
            <h3 class="text-lg font-semibold">{a.name}</h3>
            <p class="mt-2 text-ink-2">{a.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <Method />
  <Cta />
</BaseLayout>
